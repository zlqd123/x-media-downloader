{
  "manifest_version": 3,
  "name": "X 媒体原图抓取器",
  "version": "1.0.0",
  "description": "抓取 x.com / twitter.com 页面（尤其用户媒体页 /media?filter=photo）全部图片，自动把缩略图链接还原为原图并批量下载。",
  "permissions": ["downloads", "storage", "clipboardWrite", "scripting", "activeTab"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://pbs.twimg.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X 媒体原图抓取器",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
